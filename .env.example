# Environment for the demo host project. Copy to .env and fill in.
# Changing .env requires a server restart.
# In a real customer project these values live in settings.POPPY (see INSTALL.md).

# ===== Required =====
GEMINI_API_KEY=your-gemini-key-with-billing
BUSINESS_NAME=Petal & Polish

# ===== Optional =====
ASSISTANT_NAME=Poppy

# ===== Django =====
DJANGO_SECRET_KEY=change-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ===== Staff notifications (Telegram) =====
# Leave blank to run in simulation mode (messages are printed to the log).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Twilio (optional, for outbound phone calls) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL for Twilio to stream call audio back to /ws/twilio.
# PUBLIC_BASE_URL=https://<tunnel>.ngrok-free.app
