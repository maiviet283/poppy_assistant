# .env cho project host demo (copy thành .env rồi điền). ⚠ Đổi .env phải restart server.
# Trong project THẬT của khách, các giá trị này đặt trong settings.POPPY (xem INSTALL.md).

# --- Bắt buộc ---
GEMINI_API_KEY=your-gemini-key-with-billing
BUSINESS_NAME=Petal & Polish

# --- Tuỳ chọn ---
ASSISTANT_NAME=Poppy
TIME_ZONE=Asia/Ho_Chi_Minh

# --- Django ---
DJANGO_SECRET_KEY=doi-mot-chuoi-ngau-nhien-dai
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Telegram (để trống -> chế độ giả lập, in log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twilio (optional [phone]) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# PUBLIC_BASE_URL=https://<tunnel>.ngrok-free.app   # để Twilio nối ngược /ws/twilio
